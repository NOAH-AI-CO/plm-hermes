# PLM engine 运行环境模板 —— 复制为 plm.env 并填真值(挂载为 /noah_agent/.env)。
# 真实的 plm.env / api.json / plm-settings.json 含密钥, 已被 .gitignore, 切勿入库。
# PLM 引擎复用 biz-agent 镜像与其配置体系(api.json + 本文件),多数取自 biz 部署。

# --- 依赖的 biz 数据层(与 biz-backend 复用同一套 Postgres / Elasticsearch) ---
BIZ_POSTGRES_USER=CHANGE_ME
BIZ_POSTGRES_PASSWORD=CHANGE_ME
BIZ_POSTGRES_DB=CHANGE_ME
BIZ_PGTABLE_DB=CHANGE_ME
BIZ_ELASTIC_PASSWORD=CHANGE_ME

# --- 对象存储(报告/附件下载, 不用可 NOAH_OSS_ENABLED=false) ---
NOAH_OSS_ENABLED=false
NOAH_OSS_PROVIDER=
NOAH_OSS_ACCESS_KEY=
NOAH_OSS_ACCESS_SECRET=
NOAH_OSS_ENDPOINT=
NOAH_OSS_REGION=
NOAH_OSS_BUCKET=
NOAH_OSS_PREFIX=
NOAH_OSS_ENV=
NOAH_OSS_SIGNED_TTL=3600

# --- 鉴权(走 biz-backend, 见 README「鉴权」一节) ---
NOAH_AUTH_ENABLED=true
NOAH_AUTH_STRICT=true
NOAH_AUTH_BIZ_BASE_URL=http://host.docker.internal:8102
NOAH_AUTH_REQUIRED_MODULE=CHANGE_ME
