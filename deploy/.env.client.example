# Client-only image and local identity integration.
# Build with: docker build -f webui/Dockerfile.client -t <tag> webui/
PLM_WEBUI_IMAGE=registry.example/plm-hermes-webui-client@sha256:<digest>
PLM_CLIENT_PORT=8090
# New client browser profiles default to the light WebUI theme. Existing user
# preferences in localStorage and settings.json remain unchanged.
HERMES_WEBUI_DEFAULT_THEME=light
HERMES_DJANGO_URL=http://bizbackend:8000
HERMES_WEBUI_LOGIN_URL=https://project-hub.example/signin?redirect=/nccn
HERMES_WEBUI_FRAME_ANCESTORS=https://project-hub.example